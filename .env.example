# Names only. Copy to .env for local runs. .env is ignored by git.
# On Railway these are set as service variables, never in a file.

# Database connection (read by the server and by `migrate`)
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# Admin login (slot 3). Made by the server's hash-password mode.
ADMIN_PASSWORD_HASH=
